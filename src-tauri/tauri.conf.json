{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Athletics",
  "version": "0.1.0",
  "identifier": "ar.gimnasio.escritorio",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "https://gimnasioathletics.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Athletics",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Athletics",
    "shortDescription": "Athletics: gestión del gimnasio",
    "category": "Business",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
